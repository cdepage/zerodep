{
  "name": "is-datestring",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/is/datestring/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf dist/packages/is/datestring/*",
          "rollup -c packages/is/datestring/rollup.config.mjs",
          "cp packages/is/datestring/README.md dist/packages/is/datestring/README.md",
          "cp LICENSE.md dist/packages/is/datestring/LICENSE.md",
          "cp SECURITY.md dist/packages/is/datestring/SECURITY.md",
          "cp packages/is/datestring/package.json dist/packages/is/datestring/package.json",
          "uglifyjs dist/packages/is/datestring/index.mjs -o dist/packages/is/datestring/index.min.mjs -c --no-annotations",
          "uglifyjs dist/packages/is/datestring/index.cjs -o dist/packages/is/datestring/index.min.cjs -c --no-annotations",
          "rm -rf dist/packages/is/datestring/index.mjs",
          "rm -rf dist/packages/is/datestring/index.cjs"
        ],
        "parallel": false
      }
    },
    "patch": {
      "command": "cd packages/is/datestring && npm version patch"
    },
    "minor": {
      "command": "cd packages/is/datestring && npm version minor"
    },
    "major": {
      "command": "cd packages/is/datestring && npm version major"
    },
    "packageFix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm-sort && fixpack",
        "cwd": "packages/is/array"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/is/datestring/jest.config.ts"
      }
    }
  }
}
